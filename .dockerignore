# Git and IDE
.git
.github
.idea
.vscode
.cursor
.claude

# Dependencies (reinstalled in build)
node_modules
vendor

# Env and secrets (bind or compose env)
.env
.env.*
!.env.example

# Laravel runtime (mounted as volumes in compose)
storage/logs
storage/framework/cache
storage/framework/sessions
storage/framework/views
bootstrap/cache

# Databases. Never bake one into the image: the entrypoint creates a blank
# SQLite file when none exists, and a file left in database/ is worse than
# dead weight. entrypoint.sh:138 treats it as a pre-2026.08 install and
# switches the app onto it, ignoring the configured volume. A local build
# would then ship the builder's own readings, settings and API keys.
# The pattern needs **/ to reach database/database.sqlite; a bare *.sqlite*
# only matches the context root.
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
**/*.sqlite3

# Optional / large
storage/app/radar-tiles
storage/app/.app-key
ecowitt
telemetry-aggregator

# Tests and dev
.phpunit.result.cache
*.md
!README.md

# Misc
*.log
.DS_Store
Thumbs.db
deploy.sh
